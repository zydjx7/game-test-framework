{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CLI tool result",
  "type": "object",
  "required": [
    "tool",
    "status",
    "exit_code",
    "checks"
  ],
  "properties": {
    "tool": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "failure"
      ]
    },
    "exit_code": {
      "type": "integer",
      "minimum": 0
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "artifact",
          "schema",
          "status"
        ],
        "properties": {
          "artifact": {
            "type": "string"
          },
          "schema": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "skipped"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
