{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bug-to-regression plan IR",
  "type": "object",
  "required": [
    "plan_id",
    "source_failure_type",
    "source_goal",
    "cases"
  ],
  "properties": {
    "plan_id": {
      "type": "string"
    },
    "source_report_path": {
      "type": "string"
    },
    "source_failure_type": {
      "type": "string",
      "enum": [
        "progression_softlock",
        "presentation_mismatch"
      ]
    },
    "source_goal": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "layer",
          "template",
          "repro_actions",
          "assertions"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "layer": {
            "type": "string",
            "enum": [
              "unit",
              "component",
              "integration",
              "editmode",
              "playmode",
              "gameplay"
            ]
          },
          "title": {
            "type": "string"
          },
          "template": {
            "type": "string"
          },
          "repro_actions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "assertions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
